# SEO Blog Publishing Agent - Environment Variables
# Copy this file to .env and fill in your actual values

# ====================
# Required Settings
# ====================

# Anthropic API Key - Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ====================
# Google Docs Settings
# ====================

# NOTE: No authentication required!
# Simply publish your Google Docs to the web (File > Share > Publish to web)
# and use the published URL (contains /pub at the end)
# Example: https://docs.google.com/document/d/e/2PACX-xxx/pub

# ====================
# WordPress Settings (Optional - only needed for publishing)
# ====================

# WordPress site URL (without trailing slash)
WP_BASE_URL=https://your-wordpress-site.com

# WordPress username
WP_USERNAME=your_wordpress_username

# WordPress Application Password
# Create one in WordPress: Users → Profile → Application Passwords
WP_APP_PASS=xxxx xxxx xxxx xxxx xxxx xxxx

# ====================
# Image Processing Settings (Optional)
# ====================

# Default image width in pixels
DEFAULT_IMAGE_WIDTH=800

# JPEG quality (1-100, higher = better quality but larger file)
IMAGE_QUALITY=92

# Image format (JPEG, PNG, WEBP)
IMAGE_FORMAT=JPEG

# ====================
# Agent Settings (Optional)
# ====================

# Claude model to use
AGENT_MODEL=claude-sonnet-4-5-20250929

# Enable debug mode (true/false)
AGENT_DEBUG=false
