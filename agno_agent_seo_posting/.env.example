# WordPress SEO Publishing System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ==============================================================================
# REQUIRED SETTINGS
# ==============================================================================

# Anthropic API Key (Required for AI features)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ==============================================================================
# OPTIONAL: DEFAULT WORDPRESS CREDENTIALS
# ==============================================================================

# Default WordPress site URL (without trailing slash)
# Example: https://yourblog.com or https://blog.yourcompany.com
WP_BASE_URL=https://your-wordpress-site.com

# WordPress username
WP_USERNAME=your_username

# WordPress Application Password (NOT your regular password!)
# Create at: WordPress Admin → Users → Profile → Application Passwords
# Format: xxxx xxxx xxxx xxxx (spaces included)
WP_APP_PASS=xxxx xxxx xxxx xxxx

# ==============================================================================
# OPTIONAL: DATABASE CONFIGURATION
# ==============================================================================

# Path to SQLite database file
# Default: ./data/clients.db
# CLIENT_DB_PATH=./data/clients.db

# ==============================================================================
# OPTIONAL: GOOGLE OAUTH CREDENTIALS
# ==============================================================================

# Path to Google OAuth client secrets file
# Default: ./credentials/client_secret.json
# GOOGLE_CLIENT_SECRETS=./credentials/client_secret.json

# Path to Google OAuth token file (auto-generated on first use)
# Default: ./credentials/token.json
# GOOGLE_TOKEN_PATH=./credentials/token.json

# ==============================================================================
# OPTIONAL: IMAGE PROCESSING SETTINGS
# ==============================================================================

# Default target width for resized images (pixels)
# Default: 800
DEFAULT_IMAGE_WIDTH=800

# Image quality for JPEG compression (0-100)
# Default: 92
IMAGE_QUALITY=92

# Image format (JPEG, PNG, WEBP)
# Default: JPEG
IMAGE_FORMAT=JPEG

# ==============================================================================
# OPTIONAL: AI MODEL SETTINGS
# ==============================================================================

# Claude model to use for AI features
# Default: claude-sonnet-4-5-20250929
# AGENT_MODEL=claude-sonnet-4-5-20250929

# Enable debug mode for agents
# Default: false
# AGENT_DEBUG=false

# ==============================================================================
# OPTIONAL: API SETTINGS (Future - for Larksuite integration)
# ==============================================================================

# API server host
# API_HOST=0.0.0.0

# API server port
# API_PORT=8000

# API authentication secret key
# API_SECRET_KEY=your-secret-key-here

# Larksuite App ID (for bot integration)
# LARK_APP_ID=your-app-id

# Larksuite App Secret (for bot integration)
# LARK_APP_SECRET=your-app-secret

# ==============================================================================
# NOTES
# ==============================================================================

# 1. Never commit the .env file to version control!
# 2. Keep your API keys and passwords secure
# 3. WordPress credentials can be set per-project in the database
# 4. Google OAuth credentials are stored in credentials/ directory
# 5. The system will prompt for missing required values on first run
